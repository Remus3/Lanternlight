#!/bin/sh
#
# Lanternlight pre-commit hook.
#
# Two jobs, both about what must never reach a public repo:
#
#   1. PII PATHS. Mistfall Hunter writes logs and saves that carry a SteamID64,
#      a Steam persona name, GSDK openID/userId, an EOS ProductUserId and
#      IP-resolved geolocation. Local screen captures of the game are just as
#      identifying. .gitignore is the first fence; this is the second, because
#      a `git add -f` or a path the ignore rules did not anticipate walks
#      straight past the first one.
#
#   2. NON-ASCII BYTES in authored text. The repo is 7-bit ASCII by rule. A
#      smuggled em-dash or smart quote breaks tooling that ANSI-decodes files
#      and makes diffs noisy for no benefit.
#
# Failures are loud and the commit is refused. To inspect a real game log,
# read it in place OUTSIDE the repo - do not copy it in and then fight the
# hook. There is no bypass documented here on purpose.
#
# This hook is only active if core.hooksPath points at .githooks/, which is
# LOCAL config and is never cloned. Run: python scripts/install_hooks.py

set -u

# IGNORE SIGPIPE. Measured 2026-09-02: piping a commit through a reader
# that closes early - "git commit ... 2>&1 | head -1" - killed this hook
# mid-message, and THE BANNED COMMIT LANDED with exit 141 while the word
# BLOCKED still appeared on screen. A guard that prints its refusal and
# then lets the commit through is worse than no guard, because the
# operator reads the refusal and believes it. Ignoring PIPE lets the
# diagnostics fail silently and still reach the exit below.
trap '' PIPE

RED=''
BOLD=''
RESET=''
if [ -t 2 ]; then
    RED=$(printf '\033[31m')
    BOLD=$(printf '\033[1m')
    RESET=$(printf '\033[0m')
fi

fail=0

# Byte-range pattern for "anything outside 7-bit ASCII", built with printf so
# no locale-dependent escape parsing is involved.
HIGH_BYTES=$(printf '[\200-\377]')

report() {
    # report <path> <reason>
    fail=1
    printf '%s%sBLOCKED%s %s\n' "$BOLD" "$RED" "$RESET" "$1" >&2
    printf '        %s\n' "$2" >&2
}

# R and T are here deliberately - see OPS-39 defect 4.
#
# This listing gates EVERY section below, and with --diff-filter=ACM a commit
# containing only a RENAME produced an empty listing, so the hook exited 0 and
# ran nothing at all: no PII path check, no glyph scan, no doc guard, no lint.
# Git reports a rename as R, which ACM excludes. Measured 2026-09-07 in a
# throwaway repo: `git mv a.py b.py` then --diff-filter=ACM returns nothing,
# while ACMR returns the DESTINATION path b.py - which is the path every
# section below actually wants.
#
# --find-renames is explicit so that a repository with diff.renames=false
# cannot silently re-open the hole by configuration.
#
# T is a type change, blob to symlink or back. It carries a destination path
# and real content, so it is scanned rather than skipped.
# D and U are still excluded: a deleted path has no content to scan, and an
# unmerged one has no single staged blob to read.
staged=$(git diff --cached --name-only --diff-filter=ACMRT --find-renames)
if [ -z "$staged" ]; then
    exit 0
fi

# Iterate in the CURRENT shell (no pipe into while) so that `fail` survives.
old_ifs=$IFS
IFS='
'
set -f
for path in $staged; do
    set +f
    IFS=$old_ifs

    # ---------------------------------------------------------------
    # 1. PII-hazard paths
    # ---------------------------------------------------------------
    case "$path" in
        frames/*|*/frames/*)
            report "$path" "sits under a frames/ directory - captured game frames are never committed"
            ;;
        captures/*|*/captures/*|capture/*|*/capture/*|screenshots/*|*/screenshots/*)
            report "$path" "sits under a capture/screenshot directory - local captures are never committed"
            ;;
        logs/*|*/logs/*)
            report "$path" "sits under a logs/ directory - game and tool logs carry account identifiers"
            ;;
        Saved/*|*/Saved/*|*MistfallHunter/*|*MistfallHunter*.log|*MistfallHunter*.sav)
            report "$path" "comes from the game Saved tree - it carries SteamID64, persona, EOS/GSDK ids and geolocation"
            ;;
        *.sav|*.sav.bak|*.savegame)
            report "$path" "is a game save file - never committed"
            ;;
        *.log|*.log.[0-9]|*.log.[0-9][0-9])
            report "$path" "is a log file - never committed"
            ;;
        # An encoded or compressed copy of a save or a log is the same bytes
        # under a name the ignore rules do not recognise. `.gitignore` blocks
        # `*.sav`, so the standing pressure is to reach for exactly this, and
        # before these two branches existed nothing stopped it. Refused
        # everywhere, tests/fixtures/ included: these names say "game file", so
        # there is no reviewed-fixture case for them.
        *.sav.b64|*.sav.base64|*.sav.hex|*.sav.txt|*.sav.gz|*.sav.zip|*.sav.*)
            report "$path" "is an encoded or derived copy of a game save - encoding is not redaction"
            ;;
        *.log.b64|*.log.base64|*.log.hex|*.log.gz|*.log.zip)
            report "$path" "is an encoded or derived copy of a log - encoding is not redaction"
            ;;
        # The same file under a name that mentions no save at all -
        # `dump.gvas.b64`, `blob.b64`, `stuff.gz`. The extension is the thing an
        # accident renames, so LOCATION decides instead: a reviewed fixture
        # lives under tests/fixtures/, where a human vetted it and
        # tests/test_no_pii.py scans its contents on every run. Anywhere else an
        # opaque blob is a raw dump until proven otherwise, and this hook cannot
        # look inside one to tell the difference.
        *.gvas|*.gvas.b64|*.gvas.base64|*.gvas.hex|*.gvas.gz \
        |*.b64|*.base64|*.hex \
        |*.gz|*.tgz|*.zip|*.7z|*.bz2|*.xz|*.tar|*.zst)
            case "$path" in
                tests/fixtures/*)
                    # Reviewed fixture tree. Permitted on purpose - blocking it
                    # would block the hand-verified GVAS fixtures the save
                    # reader is tested against, and a rule that blocks the
                    # reviewed fixtures is a broken rule, not a strict one.
                    ;;
                *)
                    report "$path" "is an encoded or compressed blob outside tests/fixtures/ - if it is a reviewed fixture it belongs there, and if it is a raw dump it belongs nowhere"
                    ;;
            esac
            ;;
    esac

    # ---------------------------------------------------------------
    # 2. Non-ASCII bytes in authored text files
    # ---------------------------------------------------------------
    case "$path" in
        *.py|*.md|*.toml|*.ini|*.txt|*.sh|*.yml|*.yaml|.githooks/*)
            # Detect with tr (byte-exact, no regex engine involved). The
            # staged blob is checked, not the working tree copy, because those
            # can differ.
            offenders=$(git show ":$path" 2>/dev/null | LC_ALL=C tr -d '\000-\177')
            if [ -n "$offenders" ]; then
                report "$path" "contains non-ASCII bytes - this repo is 7-bit ASCII only (no em-dash, en-dash or smart quotes)"
                # Line numbers are best effort; the tr check above is the
                # authoritative one.
                git show ":$path" 2>/dev/null \
                    | LC_ALL=C grep -n "$HIGH_BYTES" 2>/dev/null \
                    | head -n 5 \
                    | while IFS= read -r hit; do
                        printf '        first offending line: %s\n' "$hit" >&2
                    done
            fi
            ;;
    esac

    set -f
    IFS='
'
done
set +f
IFS=$old_ifs

# ---------------------------------------------------------------
# 3. DOC GUARDS - staged Markdown is a code change. ROADMAP OPS-31
# ---------------------------------------------------------------
#
# WHY THIS BLOCK EXISTS. Several test modules read tracked .md files and
# assert on their CONTENT - tests/test_source_register.py walks every .md
# under docs/ and requires every module-ish token it finds to be registered.
# So a ledger or roadmap entry is a code change as far as the suite is
# concerned. A wrap measures the suite, THEN writes the entry recording that
# measurement, and the entry's own prose reddens the tree it is committed
# into. Measured three times - ac7fd5e (LL-0087), c9a0f76 (LL-0140) and
# LL-0147. CI caught all three AFTER the push, which is what a badge can do
# and exactly what is not enough.
#
# WHAT IT DOES, in this order, and only when a .md is staged:
#
#   a. Refuses a staged .md whose content differs from the working tree copy.
#      The suite runs against the working tree, so if the two differ the run
#      did not measure what lands and everything below is about another file.
#   b. Asks ops/docguards.py which test modules read the STAGED documents.
#      That set is DERIVED at run time from git ls-files and from the modules'
#      own source. It is never a list in a file: a list is silently green over
#      every document and every module added after it was written. Modules
#      that walk for Markdown rather than naming a file are always in, because
#      they read whatever is there.
#   c. Refuses when the persisted observed map - what an audit hook watched
#      really being opened during the last complete suite run - names a module
#      the selector did not pick. That is the coverage guard, and it fires
#      here rather than in a test because here is where it matters.
#   d. Runs the selected subset and refuses on failure.
#
# AN ABSENT OR STALE OBSERVED MAP REFUSES. It does not warn and proceed. The
# map is the only evidence that the tree in front of this hook was ever run,
# and OPS-31 is precisely a gate pointed at a tree that was not the one being
# committed - failing open here would rebuild that defect with extra steps.
# The cost is one `python -m pytest` after a fresh clone or after editing a
# test module, and the refusal says so. ops/runtime/ is gitignored, so a
# fresh clone always starts without a map.
#
# A REPOSITORY THAT DOES NOT CARRY ops/docguards.py IS SKIPPED, not refused.
# tests/test_no_pii.py and tests/test_ascii_hygiene.py copy this hook into
# throwaway repositories and commit into them, and the first of those commits
# a README.md. There is no selector there, no test tree to select from and no
# suite to run - it is not Lanternlight. tests/test_docguards.py pins both
# halves: the skip there, and the refusal in a repository that does carry it.

staged_md=$(printf '%s\n' "$staged" | grep '\.md$')
staged_py=$(printf '%s\n' "$staged" | grep '\.py$')
repo_top=$(git rev-parse --show-toplevel 2>/dev/null) || repo_top=.

# The interpreter, shared by sections 3 and 4. LL_PYTHON wins so a different
# checkout can point this somewhere else without editing a tracked hook.
find_python() {
    for cand in ${LL_PYTHON:-} python python3 \
        "${USERPROFILE:-$HOME}/AppData/Local/Programs/Python/Python314/python.exe" \
        "${LOCALAPPDATA:-}/Programs/Python/Python314/python.exe"
    do
        if "$cand" -c "import sys" >/dev/null 2>&1; then
            printf '%s\n' "$cand"
            return 0
        fi
    done
    return 1
}

if [ "$fail" -eq 0 ] && [ -n "$staged_md" ] && [ -f "$repo_top/ops/docguards.py" ]; then

    # a. What lands must be what was run.
    md_ifs=$IFS
    IFS='
'
    set -f
    for doc in $staged_md; do
        set +f
        IFS=$md_ifs
        if [ -n "$(git diff --name-only -- "$doc")" ]; then
            report "$doc" "is staged with content that differs from the working tree - the suite runs against the working tree, so no run has measured what would land"
        fi
        set -f
        IFS='
'
    done
    set +f
    IFS=$md_ifs

    py_bin=$(find_python) || py_bin=

    if [ "$fail" -eq 0 ] && [ -z "$py_bin" ]; then
        report ".githooks/pre-commit" "no working python was found, so the doc-reading tests cannot run against the staged Markdown - set LL_PYTHON"
    fi

    if [ "$fail" -eq 0 ]; then
        # b. The selector. Derived at run time; see ops/docguards.py. It reads
        # the staged set itself, so no quoting mistake here can narrow it.
        selected=$("$py_bin" -m ops.docguards select-staged 2>&1)
        if [ $? -ne 0 ]; then
            report ".githooks/pre-commit" "the doc-guard selector failed to run"
            printf '        %s\n' "$selected" >&2
        else
            selected=$(printf '%s\n' "$selected" | tr -d '\r')
            if [ -z "$selected" ]; then
                report ".githooks/pre-commit" "the selector chose NO test module while Markdown is staged - a selector that selects nothing is not a guard"
            fi
        fi
    fi

    if [ "$fail" -eq 0 ]; then
        # c. The coverage guard - the second, independent derivation.
        observed=$("$py_bin" -m ops.docguards check-observed 2>&1)
        if [ $? -ne 0 ]; then
            report ".githooks/pre-commit" "the observed doc-open map is absent, stale or has a coverage gap"
            printf '%s\n' "$observed" | tr -d '\r' | while IFS= read -r line; do
                printf '        %s\n' "$line" >&2
            done
        fi
    fi

    if [ "$fail" -eq 0 ]; then
        # d. Run the subset against the tree that is about to land.
        #
        # SCRUB GIT'S HOOK ENVIRONMENT FIRST, and only here. git exports
        # GIT_DIR, GIT_INDEX_FILE and friends to a hook, and every `git`
        # this suite runs in a THROWAWAY repository would inherit them and
        # operate on the repository being committed instead. Measured
        # 2026-09-06 planting the OPS-31 defect in a clone: four
        # tests/test_lane_launcher.py tests failed inside the hook with
        # "Unable to create .../ll-lane-ingest/.git/index.lock" and passed
        # standalone. That is a false refusal, and a guard that cries wolf
        # is a guard that gets switched off.
        #
        # The three python calls above KEEP the ambient environment on
        # purpose: `git diff --cached` has to read the index being
        # committed, and under `git commit -a` that index is a temporary
        # one named only by GIT_INDEX_FILE.
        md_count=$(printf '%s\n' "$staged_md" | wc -l | tr -d ' ')
        mod_count=$(printf '%s\n' "$selected" | wc -l | tr -d ' ')
        printf '%spre-commit%s %s staged .md - running %s doc-reading test module(s)\n' \
            "$BOLD" "$RESET" "$md_count" "$mod_count" >&2
        if ! (
            unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX \
                GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
                GIT_QUARANTINE_PATH GIT_COMMON_DIR GIT_CONFIG_PARAMETERS \
                GIT_AUTHOR_DATE GIT_EDITOR
            exec "$py_bin" -m pytest $selected
        ) >&2; then
            report ".githooks/pre-commit" "the doc-reading test subset FAILED against the staged tree - the prose being committed reddens the suite"
        fi
    fi
fi

# ---------------------------------------------------------------
# 4. LINT GATE - net-new lines ONLY. ROADMAP OPS-37
# ---------------------------------------------------------------
#
# WHY IT IS SCOPED. This repository has always linted manually and tree-wide,
# with nothing at commit time. The obvious fix - run ruff over the tree and
# refuse on any finding - is the wrong one: one pre-existing finding anywhere
# then refuses every commit, including commits that never opened the offending
# file. That guard does not get fixed, it gets switched off, and a switched-off
# guard still looks armed. So the question asked here is the narrow one: did
# THIS commit write a bad line. tools/precommit_gate.py lint-staged answers it
# by intersecting ruff's findings with the added-line ranges of the staged
# diff, and it lints the STAGED blob rather than the working tree so the line
# numbers and the text come from the same place.
#
# A REPOSITORY THAT DOES NOT CARRY tools/precommit_gate.py IS SKIPPED, exactly
# as section 3 skips one without ops/docguards.py. tests/test_no_pii.py and
# tests/test_docguards.py both point throwaway repositories at this hook and
# commit ordinary .py files into them; those trees are not Lanternlight, have
# no ruff config, and refusing there would be a false alarm in another test's
# fixture. tests/test_precommit_gate_lint.py pins the skip and the refusal.
#
# The ambient git environment is KEPT here, like the python calls in section 3
# and unlike the pytest run: the gate has to read the index being committed,
# which under `git commit -a` is a temporary one named only by GIT_INDEX_FILE.

if [ "$fail" -eq 0 ] && [ -n "$staged_py" ] && [ -f "$repo_top/tools/precommit_gate.py" ]; then
    lint_py=$(find_python) || lint_py=
    if [ -z "$lint_py" ]; then
        report ".githooks/pre-commit" "no working python was found, so the staged Python cannot be linted - set LL_PYTHON"
    else
        lint_out=$("$lint_py" "$repo_top/tools/precommit_gate.py" lint-staged 2>&1)
        if [ $? -ne 0 ]; then
            report ".githooks/pre-commit" "ruff reported findings on lines this commit ADDS"
            printf '%s\n' "$lint_out" | tr -d '\r' | while IFS= read -r line; do
                printf '        %s\n' "$line" >&2
            done
        fi
    fi
fi

if [ "$fail" -ne 0 ]; then
    printf '\n%s%spre-commit REFUSED the commit.%s\n' "$BOLD" "$RED" "$RESET" >&2
    printf 'Unstage the offending paths (git restore --staged <path>) and fix them.\n' >&2
    printf 'PII reminder: anything out of the game Saved tree is public forever once pushed.\n\n' >&2
    exit 1
fi

exit 0
