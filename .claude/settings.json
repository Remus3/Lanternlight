{
  "$comment": "Lanternlight Claude Code settings. Windows paths MUST use forward slashes - a single backslash makes this file invalid JSON, and an unparseable settings file registers no hooks and warns about nothing. The PreToolUse matcher MUST name every shell tool that can reach git: this machine is PowerShell-primary, and a matcher of 'Bash' alone let a commit issued through the PowerShell tool bypass the gate entirely. Measured 2026-08-09.",
  "permissions": {
    "allow": [
      "Bash(python -m pytest*)",
      "Bash(python -m ruff*)",
      "Bash(python scripts/install_hooks.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read(//C/Lanternlight/**)",
      "Write(//C/Lanternlight/**)",
      "Edit(//C/Lanternlight/**)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Administrator/AppData/Local/Programs/Python/Python314/python.exe C:/Lanternlight/tools/precommit_gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Administrator/AppData/Local/Programs/Python/Python314/python.exe C:/Lanternlight/tools/ascii_check.py"
          }
        ]
      }
    ]
  }
}
